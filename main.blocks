<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="/3.U1eWpa!y89-9}JHTh" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="~2xlKF_lItSWQRu3KPOg"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace ch926 {" line1="    let polsosTotals = 0" line2="    let polsosMonedaActual = 0" line3="    let ultimPols = 0" line4="    let valorPerPols = 0.5" line5="    let callbackMoneda: (importMoneda: number) =&gt; void = null" line6="    let inicialitzat = false" line7="" line8="    /**" line9="     * Inicialitza el selector CH-926 al pin indicat amb pull-up intern" line10="     * @param pin Pin on està connectat el cable blanc (COIN), eg: DigitalPin.P0" line11="     * @param valorPols Valor en euros de cada pols (ex. 0.50), eg: 0.5" line12="     */" line13="    //% blockId=ch926_init" line14="    //% block=&quot;inicia CH-926 al pin %pin amb valor per pols %valorPols €&quot;" line15="    //% valorPols.defl=0.5" line16="    //% weight=100" line17="    export function inicia(pin: DigitalPin, valorPols: number): void {" line18="        valorPerPols = valorPols" line19="        pins.setPull(pin, PinPullMode.PullUp)" line20="" line21="        pins.onPulsed(pin, PulseValue.Low, function () {" line22="            polsosTotals += 1" line23="            polsosMonedaActual += 1" line24="            ultimPols = input.runningTime()" line25="        })" line26="" line27="        if (!inicialitzat) {" line28="            inicialitzat = true" line29="            control.inBackground(function () {" line30="                while (true) {" line31="                    if (polsosMonedaActual &gt; 0 &amp;&amp; (input.runningTime() - ultimPols &gt; 350)) {" line32="                        let importRebut = polsosMonedaActual * valorPerPols" line33="                        polsosMonedaActual = 0" line34="                        if (callbackMoneda) {" line35="                            callbackMoneda(importRebut)" line36="                        }" line37="                    }" line38="                    basic.pause(50)" line39="                }" line40="            })" line41="        }" line42="    }" line43="" line44="    /**" line45="     * S'executa cada vegada que s'acaba d'introduir una moneda" line46="     */" line47="    //% blockId=ch926_on_coin" line48="    //% block=&quot;en rebre moneda de $importMoneda €&quot;" line49="    //% draggableParameters=&quot;reporter&quot;" line50="    //% weight=90" line51="    export function enRebreMoneda(handler: (importMoneda: number) =&gt; void): void {" line52="        callbackMoneda = handler" line53="    }" line54="" line55="    /**" line56="     * Retorna l'import total acumulat en euros" line57="     */" line58="    //% blockId=ch926_total" line59="    //% block=&quot;import total (€)&quot;" line60="    //% weight=80" line61="    export function importTotal(): number {" line62="        return polsosTotals * valorPerPols" line63="    }" line64="" line65="    /**" line66="     * Reinicia el comptador de diners a zero" line67="     */" line68="    //% blockId=ch926_reset" line69="    //% block=&quot;reinicia comptador CH-926&quot;" line70="    //% weight=70" line71="    export function reinicia(): void {" line72="        polsosTotals = 0" line73="        polsosMonedaActual = 0" line74="    }" line75="}" numlines="76"></mutation></block></statement></block></xml>